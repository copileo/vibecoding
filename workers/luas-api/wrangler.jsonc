{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibecode-luas-api",
  "main": "src/entry.js",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "durable_objects": {
    "bindings": [
      { "name": "REMINDER_SCHEDULER", "class_name": "ReminderScheduler" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ReminderScheduler"] }
  ]
}
